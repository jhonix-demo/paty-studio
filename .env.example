# Copia a .env (nunca lo subas a GitHub)
# Backblaze B2: https://s3.us-west-004.backblazeb2.com (usa el endpoint y región que te muestre tu bucket)
S3_ENDPOINT=
S3_REGION=us-west-004
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# URL pública para leer los archivos, sin "/" al final.
# B2: https://f004.backblazeb2.com/file/NOMBRE-DEL-BUCKET (en tu bucket verás la URL real de un archivo)
PUBLIC_URL=
