---
import data from '../../data/fotos.json';
const { base, grupales, personas } = data;
const FOTOGRAFA = 'Nombre de la fotógrafa'; // ← cámbialo
const u = (k) => `${base}/${k}`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Escuela del Servicio de Precursor 2026 · Fotos #1</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif&display=swap" rel="stylesheet" />
</head>
<body>
  <header>
    <p class="by">{FOTOGRAFA}</p>
    <h1>Escuela del Servicio de Precursor 2026</h1>
    <p class="sub">Entrega #1. Toca una foto para verla en grande y descargarla en su calidad original.</p>
  </header>

  <main>
    <section>
      <h2>Fotos grupales <span class="n">{grupales.length}</span></h2>
      {grupales.length === 0 && <p class="msg">Aún no hay fotos grupales.</p>}
      <div class="grid" id="grupales">
        {grupales.map((f, n) => (
          <button type="button" aria-label={`Abrir foto grupal ${n + 1}`}>
            <img src={u(f.t)} width={f.w} height={f.h} loading="lazy" alt="" />
          </button>
        ))}
      </div>
    </section>

    <section>
      <h2>Fotos individuales</h2>
      <label for="q">Busca tu nombre</label>
      <input id="q" type="search" placeholder="Ej. Josías, o Uriel y Diana" autocomplete="off" />
      <p class="msg" id="msg">Escribe al menos 2 letras de tu nombre.</p>
      <div id="res"></div>
    </section>
  </main>

  <footer>© {new Date().getFullYear()} {FOTOGRAFA}. Fotos para uso personal.</footer>

  <dialog id="lb" aria-label="Visor de fotos">
    <div class="bar">
      <span class="cnt"></span>
      <span>
        <a class="dl btn" download>Descargar original</a>
        <button type="button" class="btn x">Cerrar</button>
      </span>
    </div>
    <button type="button" class="nav prev" aria-label="Anterior">‹</button>
    <img alt="" />
    <button type="button" class="nav next" aria-label="Siguiente">›</button>
  </dialog>

  <script define:vars={{ base, grupales, personas }}>
    const u = (k) => `${base}/${k}`;
    const dlg = document.getElementById('lb');
    const img = dlg.querySelector('img');
    const dl = dlg.querySelector('.dl');
    const cnt = dlg.querySelector('.cnt');
    let L = [], i = 0;
    const show = () => { const f = L[i]; img.src = u(f.p); dl.href = u(f.o); cnt.textContent = `${i + 1} / ${L.length}`; };
    const open = (list, n) => { L = list; i = n; show(); dlg.showModal(); };
    const step = (d) => { i = (i + d + L.length) % L.length; show(); };
    dlg.querySelector('.prev').onclick = () => step(-1);
    dlg.querySelector('.next').onclick = () => step(1);
    dlg.querySelector('.x').onclick = () => dlg.close();
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') step(-1); if (e.key === 'ArrowRight') step(1); });
    dlg.addEventListener('close', () => { img.removeAttribute('src'); });

    document.querySelectorAll('#grupales button').forEach((b, n) => b.addEventListener('click', () => open(grupales, n)));

    const norm = (s) => s.normalize('NFD').replace(/\p{M}/g, '').toLowerCase().trim();
    const q = document.getElementById('q'), msg = document.getElementById('msg'), res = document.getElementById('res');
    const el = (tag, cls, txt) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt) e.textContent = txt; return e; };

    q.addEventListener('input', () => {
      res.replaceChildren();
      const t = norm(q.value);
      if (t.length < 2) { msg.textContent = 'Escribe al menos 2 letras de tu nombre.'; return; }
      const hits = personas.filter((p) => t.split(/\s+/).every((w) => norm(p.nombre).includes(w)));
      msg.textContent = hits.length ? '' : 'No encontramos ese nombre. Revisa la ortografía o prueba solo con el nombre.';
      hits.forEach((p) => {
        const box = el('div', 'persona');
        box.append(el('h3', '', p.nombre));
        const g = el('div', 'grid');
        p.fotos.forEach((f, n) => {
          const b = el('button'); b.type = 'button'; b.ariaLabel = `Abrir foto ${n + 1} de ${p.nombre}`;
          const im = el('img'); im.src = u(f.t); im.width = f.w; im.height = f.h; im.loading = 'lazy'; im.alt = '';
          b.append(im); b.onclick = () => open(p.fotos, n); g.append(b);
        });
        box.append(g); res.append(box);
      });
    });
  </script>

  <style is:global>
    :root { --bg:#F5F6F7; --ink:#15171A; --muted:#6A7078; --line:#DDE0E4; --accent:#1F3A5F; }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin:0; background:var(--bg); color:var(--ink); font:400 16px/1.55 'Instrument Sans', system-ui, sans-serif; }
    header, main, footer { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 48px); }
    header { padding-top: clamp(48px, 10vw, 112px); padding-bottom: 40px; }
    .by { margin:0 0 20px; color:var(--muted); font-size:15px; }
    h1 { font:400 clamp(40px, 8vw, 88px)/1.02 'Instrument Serif', Georgia, serif; letter-spacing:-.02em; margin:0; max-width:14ch; }
    .sub { color:var(--muted); max-width:46ch; margin:24px 0 0; }
    section { padding: 48px 0; border-top: 1px solid var(--line); }
    h2 { font:400 32px/1.1 'Instrument Serif', Georgia, serif; margin:0 0 24px; }
    h3 { font-weight:600; font-size:17px; margin:32px 0 12px; }
    .n { color:var(--muted); font-size:16px; font-family:'Instrument Sans',sans-serif; margin-left:6px; }
    .grid { columns: 3 280px; column-gap: 12px; }
    .grid button { display:block; width:100%; margin:0 0 12px; padding:0; border:0; background:#E7E9EC; cursor:zoom-in; break-inside:avoid; overflow:hidden; }
    .grid img { display:block; width:100%; height:auto; transition: opacity .2s; }
    .grid button:hover img { opacity:.88; }
    label { display:block; font-weight:500; margin-bottom:8px; }
    input { width:100%; max-width:480px; padding:14px 16px; font:inherit; background:#fff; border:1px solid var(--line); border-radius:6px; }
    :focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
    .msg { color:var(--muted); margin:12px 0 0; }
    footer { padding-top:32px; padding-bottom:48px; color:var(--muted); font-size:14px; }
    dialog { border:0; padding:0; margin:0; width:100vw; height:100vh; max-width:none; max-height:none; background:#0F1013; color:#fff; }
    dialog[open] { display:grid; grid-template-rows:auto 1fr; grid-template-columns:56px 1fr 56px; }
    dialog .bar { grid-column:1/-1; display:flex; justify-content:space-between; align-items:center; padding:12px 16px; font-size:14px; }
    dialog img { grid-column:2; grid-row:2; max-width:100%; max-height:calc(100vh - 72px); margin:auto; object-fit:contain; }
    .nav { grid-row:2; background:none; border:0; color:#fff; font-size:40px; cursor:pointer; opacity:.7; }
    .nav:hover { opacity:1; } .prev { grid-column:1; } .next { grid-column:3; }
    .btn { display:inline-block; padding:8px 14px; margin-left:8px; border:1px solid #fff4; border-radius:6px; background:transparent; color:#fff; font:inherit; font-size:14px; text-decoration:none; cursor:pointer; }
    .btn.dl { background:#fff; color:#0F1013; border-color:#fff; }
    @media (max-width:600px) { dialog[open] { grid-template-columns:36px 1fr 36px; } .nav { font-size:30px; } }
  </style>
</body>
</html>
